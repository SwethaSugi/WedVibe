# Postgres (Neon → your project → Connect). DATABASE_URL is the pooled connection string,
# DATABASE_URL_UNPOOLED the direct one (untick "Connection pooling").
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs login sessions. Required in production — use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-in-production"

# WhatsApp OTP delivery.
#   mock — local testing: the code is shown on the login screen and logged (refused in production).
#   meta — real WhatsApp messages via Meta's WhatsApp Cloud API. Fill in the values below:
#     WHATSAPP_PHONE_NUMBER_ID   Meta App → WhatsApp → API Setup → "Phone number ID"
#     WHATSAPP_ACCESS_TOKEN      permanent System User token (whatsapp_business_messaging permission)
#     WHATSAPP_OTP_TEMPLATE      name of your approved AUTHENTICATION template (e.g. wedvibe_login_otp)
#     WHATSAPP_TEMPLATE_LANGUAGE the template's language code, e.g. en or en_US (default en)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional Graph API version (default v23.0).
WHATSAPP_API_VERSION=

# Payment gateway.
#   mock     — local testing only: a simulated checkout, no money moves (refused in production).
#   razorpay — real payments. KEY = Razorpay Key ID, SECRET = Razorpay Key Secret
#              (Razorpay Dashboard → Account & Settings → API Keys; use rzp_test_ keys first).
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
# Razorpay webhook secret — any strong random string. Enter the SAME value in Razorpay Dashboard
# → Account & Settings → Webhooks, with URL https://<your-domain>/api/payments/webhook and the
# events payment.captured, order.paid, payment.failed. Keep Payment Capture on "Automatic".
RAZORPAY_WEBHOOK_SECRET=

# Uploaded photos and songs. On Netlify set STORAGE_PROVIDER=netlify (Netlify Blobs, no keys
# needed). Leave both empty locally to save them under public/uploads.
# BLOB_READ_WRITE_TOKEN is only for hosting on Vercel with Vercel Blob instead.
STORAGE_PROVIDER=
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# How customers order:
#   whatsapp (default) — "Order on WhatsApp" buttons; the team builds and publishes invitations in
#                        Admin → Invitations (optionally sending the customer a no-login details form).
#                        Customer login, My Invitations and online payment are switched off.
#   online             — self-serve: WhatsApp OTP login, editor and Razorpay checkout
#                        (needs the WHATSAPP_* and PAYMENT_* settings above).
NEXT_PUBLIC_ORDER_MODE=whatsapp

# Your business WhatsApp number (country code + number, e.g. 919876543210). Used by the
# "Message us on WhatsApp" buttons on the Custom Design page and in the footer.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Contact page / policy details, each shown only when set. Razorpay's website review expects
# visible contact details (at least an email; an address is recommended).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Optional, defaults to "Monday to Saturday, 10:00 AM – 7:00 PM IST".
NEXT_PUBLIC_SUPPORT_HOURS=

# Admin panel login created by `npx prisma db seed`. Choose your own strong password.
# If ADMIN_PASSWORD is left empty, the seed generates a random one and prints it once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
