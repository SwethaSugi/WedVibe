DATABASE_URL="file:./dev.db"

# Signs login sessions. Required in production — use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-in-production"

# WhatsApp OTP provider. When PROVIDER=mock, OTPs are logged to the server console instead of sent.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Payment gateway.
#   mock     — local testing only: a simulated checkout, no money moves (refused in production).
#   razorpay — real payments. KEY = Razorpay Key ID, SECRET = Razorpay Key Secret
#              (Razorpay Dashboard → Account & Settings → API Keys; use rzp_test_ keys first).
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
# Razorpay webhook secret — any strong random string. Enter the SAME value in Razorpay Dashboard
# → Account & Settings → Webhooks, with URL https://<your-domain>/api/payments/webhook and the
# events payment.captured, order.paid, payment.failed. Keep Payment Capture on "Automatic".
RAZORPAY_WEBHOOK_SECRET=

# Object storage for uploaded images. When PROVIDER=local, files are saved under /public/uploads (dev only).
STORAGE_PROVIDER=local
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your business WhatsApp number (country code + number, e.g. 919876543210). Used by the
# "Message us on WhatsApp" buttons on the Custom Design page and in the footer.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Contact page / policy details, each shown only when set. Razorpay's website review expects
# visible contact details (at least an email; an address is recommended).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# Optional, defaults to "Monday to Saturday, 10:00 AM – 7:00 PM IST".
NEXT_PUBLIC_SUPPORT_HOURS=

# Admin panel login created by `npx prisma db seed`. Choose your own strong password.
# If ADMIN_PASSWORD is left empty, the seed generates a random one and prints it once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
