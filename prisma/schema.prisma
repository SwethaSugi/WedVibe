generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  mobile      String   @unique
  name        String?
  status      String   @default("ACTIVE") // ACTIVE | DISABLED
  pinHash           String?   // set after the first OTP login; used for later logins
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations Invitation[]
  payments    Payment[]
  otps        OtpVerification[]
}

model OtpVerification {
  id            String    @id @default(cuid())
  mobile        String
  otpHash       String
  expiresAt     DateTime
  attemptCount  Int       @default(0)
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
}

model Template {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  category       String
  price          Int      // in paise/rupees (INR whole rupees)
  offerPrice     Int?     // optional discounted price (whole rupees); used only while it is below price
  currency       String   @default("INR")
  previewImage   String?
  componentKey   String   // maps to a registered template component, e.g. "royal-gold"
  supportedFields String  // JSON-encoded string array
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE | DRAFT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invitations    Invitation[]
}

// Royalty-free songs admins add for couples to pick in the editor. Keep a record of where each
// track came from and its licence, so every song's right to be used can be shown if asked.
model MusicTrack {
  id         String   @id @default(cuid())
  title      String
  mood       String   // e.g. "Shehnai", "Nadaswaram", "Piano", "Romantic"
  url        String   // /uploads/music/<file>
  source     String   // e.g. "Pixabay Music"
  sourceUrl  String?  // page the track was downloaded from
  license    String?  // e.g. "Pixabay Content License"
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())
}

model Invitation {
  id             String   @id @default(cuid())
  invitationCode String   @unique
  slug           String   @unique
  userId         String
  templateId     String
  invitationData String   // JSON-encoded InvitationData
  status         String   @default("DRAFT") // DRAFT | PAYMENT_PENDING | PAID | PUBLISHED | ACTIVE | INACTIVE
  views          Int      @default(0)
  activatedAt    DateTime? // when payment was verified and the invitation went live
  editCount      Int      @default(0) // edits saved after going live (limited)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User      @relation(fields: [userId], references: [id])
  template       Template  @relation(fields: [templateId], references: [id])
  events         Event[]
  payments       Payment[]
}

model Event {
  id            String   @id @default(cuid())
  invitationId  String
  eventName     String
  eventDate     String?
  eventTime     String?
  venue         String?
  description   String?
  displayOrder  Int      @default(0)

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  invitationId  String?
  templateId    String
  gateway       String   @default("MOCK") // MOCK | RAZORPAY | CASHFREE | PHONEPE
  orderId       String   @unique
  paymentId     String?
  amount        Int
  currency      String   @default("INR")
  status        String   @default("CREATED") // CREATED | PENDING | SUCCESS | FAILED | REFUNDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  invitation    Invitation? @relation(fields: [invitationId], references: [id])
}

model CustomRequest {
  id           String   @id @default(cuid())
  name         String
  mobile       String
  email        String?
  requirements String
  status       String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt    DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
}
